# Copy to .env and adjust. Every value here is optional.

# HTTP port the dashboard listens on.
PORT=5555

# Loopback by default. Set to 0.0.0.0 or a LAN IP to reach it from other machines.
# The API is unauthenticated, so only do this on a trusted network.
BIND_HOST=127.0.0.1

# How often each node is polled, and how often snapshots are pushed to browsers.
POLL_INTERVAL_MS=2000
PUSH_INTERVAL_MS=1000

# Samples retained per metric for the sparklines (300 x 2s = 10 minutes).
HISTORY_LENGTH=300

# Timeouts. Kept short so one unresponsive host cannot stall the poll loop.
SSH_CONNECT_TIMEOUT=5
COMMAND_TIMEOUT_MS=8000
HTTP_PROBE_TIMEOUT_MS=3000

# Consecutive failed polls before a node is shown as offline.
OFFLINE_THRESHOLD=3

# Encrypts stored SSH passwords and vault secrets. If unset, a random key is
# written to config/.secret-key on first run.
# SECRET_KEY=

# Where nodes.json, the secret store and the vault live.
# CONFIG_DIR=./config

# The run planner's recipe catalogue. Defaults to recipes.yaml at the repo root;
# point this elsewhere to keep your own recipes out of the tree.
# RECIPES_FILE=./recipes.yaml

# Serves synthetic metrics so the UI can be run without any hardware.
# DEMO_MODE=1

# Set to 1 when running in Docker with --pid=host to read the host's namespace
# for a node configured as "local".
# HOST_NSENTER=0
